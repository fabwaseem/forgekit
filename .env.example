# Postgres with pgvector. Matches docker-compose.yml.
DATABASE_URL=postgres://forge:forge@127.0.0.1:5432/forgekit

# Required before you share a deployment. `scripts/setup.sh` fills this in locally.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional GitHub OAuth. Both values must be set or the button stays hidden.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Model providers. Only providers with a key appear in the picker.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Local models. Set the base URL to show Ollama in the picker.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=llama3.2,qwen2.5,mistral

# Embeddings. Leave EMBEDDING_PROVIDER empty to pick the first available of openai, google, ollama.
# Vectors are 1536 dimensions (text-embedding-3-small). Other models must match.
EMBEDDING_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Rate limit. Upstash is used when both REST variables are set; otherwise Postgres is used.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
