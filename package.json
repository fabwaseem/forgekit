{
  "name": "forgekit",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready Next.js 16 AI starter: streaming chat, tool calling, RAG on pgvector, multi-provider models, Better Auth, and Drizzle.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
