    "@ai-sdk/openai": "4.0.95",
    "@ai-sdk/react": "4.0.146",
    "@ai-sdk/xai": "5.0.23",
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "ai": "7.0.142",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "ollama-ai-provider-v2": "4.0.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.0",
    "zod": "4.6.7"
